# SolHire — Environment Variables
# Copy this to .env.local for local development
# Set these on Netlify for production

# Backend API base URL (indexer)
VITE_API_BASE=http://localhost:4001

# WebSocket base URL (indexer)
VITE_WS_BASE=ws://localhost:4001

# x402 Gateway URL
VITE_GATEWAY_BASE=http://localhost:4002
